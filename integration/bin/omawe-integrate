#!/bin/bash
# Wires omawe into Omarchy's user config, or takes it out again with --remove.
# Idempotent: safe to run after every update. Never touches /usr/share/omarchy.
set -euo pipefail

MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
HYPR="$HOME/.config/hypr/hyprland.lua"
HOOKS="$HOME/.config/omarchy/hooks"
# Files come from install.sh's per-user copy, or from the system package.
SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/omawe/integration"
[[ -d $SHARE ]] || SHARE=/usr/share/omawe/integration
PLUGIN="$HOME/.config/omarchy/plugins/org.pluseight.omawe"
REQUIRE='require("hypr.omawe") -- omawe key bindings'

# Our block always goes out first, so re-running never duplicates it.
[[ -f $MENU ]] && sed -i '/omawe-menu-start/,/omawe-menu-end/d' "$MENU"
[[ -f $HYPR ]] && sed -i '/require("hypr.omawe")/d' "$HYPR"

if [[ ${1:-} == --remove ]]; then
  rm -f "$HOOKS/theme-set.d/50-omawe" "$HOOKS/post-update.d/50-omawe"
  exit 0
fi
systemctl --user daemon-reload

# Menu > Style > Wallpaper Engine
mkdir -p "$(dirname "$MENU")"
[[ -s $MENU ]] || printf '{\n}\n' >"$MENU"
if [[ $(tail -n 1 "$MENU") == "}" ]]; then
  sed -i '$ d' "$MENU"
  cat >>"$MENU" <<'JSONC'
// omawe-menu-start
  "style.omawe": {"icon":"󰸉","label":"Wallpaper Engine","keywords":"live animated wallpaper steam workshop omawe"},
  "style.omawe.pick": {"icon":"󰸉","label":"Pick wallpaper","action":"omawe pick"},
  "style.omawe.tui": {"icon":"","label":"Browse in terminal","action":"omarchy-launch-or-focus-tui omawe-tui"},
  "style.omawe.favourites": {"icon":"󰓎","label":"Favourites","action":"omawe pick --fav"},
  "style.omawe.next": {"icon":"󰒭","label":"Next","action":"omawe next"},
  "style.omawe.random": {"icon":"󰒟","label":"Random","action":"omawe random"},
  "style.omawe.pause": {"icon":"󰏤","label":"Pause / resume","action":"omawe toggle"},
  "style.omawe.stop": {"icon":"󰓛","label":"Stop (keep still frame)","action":"omawe stop"},
// omawe-menu-end
}
JSONC
else
  echo "omawe: $MENU does not end with '}', menu entry skipped" >&2
fi

# Key bindings: our own file, one require line in the user's hyprland.lua.
if [[ -f $HYPR ]]; then
  [[ -f $HOME/.config/hypr/omawe.lua ]] || cp "$SHARE/hypr/omawe.lua" "$HOME/.config/hypr/omawe.lua"
  printf '%s\n' "$REQUIRE" >>"$HYPR"
fi

install -Dm755 "$SHARE/hooks/theme-set" "$HOOKS/theme-set.d/50-omawe"
install -Dm755 "$SHARE/hooks/post-update" "$HOOKS/post-update.d/50-omawe"

# The system package ships the shell plugin outside the home directory; the shell only loads it from there.
if [[ -d /usr/share/omawe/plugin ]] && ! diff -rq /usr/share/omawe/plugin "$PLUGIN" >/dev/null 2>&1; then
  rm -rf "$PLUGIN"
  mkdir -p "$PLUGIN"
  cp -r /usr/share/omawe/plugin/. "$PLUGIN/"
  omarchy plugin enable org.pluseight.omawe >/dev/null 2>&1 || true
  # The shell keeps the previous version of a loaded widget until it restarts.
  omarchy restart shell >/dev/null 2>&1 || true
fi

systemctl --user is-enabled -q omawed.service 2>/dev/null || systemctl --user enable -q omawed.service || true
