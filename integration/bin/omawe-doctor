#!/bin/bash
# Checks everything omawe depends on and says how to fix what is wrong.
# `omawe doctor --fix` also repairs the integration points it can.
set -u

ID=org.pluseight.omawe
bad=0
ok()   { printf '\033[32m✓\033[0m %s\n' "$1"; }
fail() { printf '\033[31m✗\033[0m %s\n    → %s\n' "$1" "$2"; bad=$((bad + 1)); }
check() { # check <description> <fix> <command...>
  local what=$1 fix=$2; shift 2
  if "$@" >/dev/null 2>&1; then ok "$what"; else fail "$what" "$fix"; fi
}

if [[ ${1:-} == --fix ]]; then
  omawe-integrate && systemctl --user restart omawed.service
  sleep 1
fi

echo "Зависимости"
check "linux-wallpaperengine установлен" "omarchy pkg aur add linux-wallpaperengine-git" command -v linux-wallpaperengine
check "ImageMagick (превью, палитра, автотест)" "omarchy pkg add imagemagick" command -v magick
check "jq (выбор обоев)" "omarchy pkg add jq" command -v jq
check "curl (данные Workshop)" "omarchy pkg add curl" command -v curl

echo "Steam и Wallpaper Engine"
steam=""
for root in "$HOME/.local/share/Steam" "$HOME/.steam/steam" "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"; do
  [[ -f $root/steamapps/libraryfolders.vdf ]] && { steam=$root; break; }
done
check "Steam найден${steam:+: $steam}" "установите Steam и войдите в аккаунт" test -n "$steam"
libs=$(grep -oP '"path"\s+"\K[^"]+' "$steam/steamapps/libraryfolders.vdf" 2>/dev/null)
we=""; items=0
while IFS= read -r lib; do
  [[ -d $lib/steamapps/common/wallpaper_engine/assets ]] && we=$lib
  n=$(find "$lib/steamapps/workshop/content/431960" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
  items=$((items + n))
done <<<"$libs"
check "Wallpaper Engine установлен (нужны его assets)" "установите Wallpaper Engine в Steam: steam://install/431960" test -n "$we"
check "подписки Workshop: $items" "подпишитесь на обои: omawe open" test "$items" -gt 0

echo "Графика"
drivers=$(for d in /sys/class/drm/card?/device/driver; do basename "$(readlink -f "$d")"; done 2>/dev/null | sort -u | xargs)
check "драйвер GPU: ${drivers:-не найден}" "нет видеодрайвера с DRM" test -n "$drivers"
check "сессия Hyprland" "omawe работает только в Hyprland" test -n "${HYPRLAND_INSTANCE_SIGNATURE:-}"

echo "Демон"
check "omawed.service запущен" "systemctl --user enable --now omawed.service; журнал: journalctl --user -u omawed" systemctl --user is-active -q omawed.service
check "демон отвечает" "systemctl --user restart omawed.service" omawe status
indexed=$(omawe list 2>/dev/null | wc -l)
check "в индексе обоев: $indexed" "omawe rescan" test "$indexed" -gt 0
state=$(omawe status --json 2>/dev/null | jq -r '.data | "\(.state)\(if .error != "" then " — " + .error else "" end)"')
check "состояние: ${state:-нет ответа}" "omawe apply <обои>; упавшие обои помечены crash в omawe list" test "${state%% *}" != stopped

echo "Интеграция с Omarchy"
fix="omawe doctor --fix"
check "плагин оболочки установлен" "./install.sh" test -f "$HOME/.config/omarchy/plugins/$ID/manifest.json"
check "плагин включён" "omarchy plugin enable $ID" sh -c "omarchy plugin list --json | jq -e '.[] | select(.id == \"$ID\" and .enabled)'"
check "пункт меню Style > Wallpaper Engine" "$fix" grep -q omawe-menu-start "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
check "бинды подключены в hyprland.lua" "$fix" grep -q 'require("hypr.omawe")' "$HOME/.config/hypr/hyprland.lua"
check "конфиг Hyprland без ошибок" "hyprctl configerrors" sh -c '[ -z "$(hyprctl configerrors 2>/dev/null | tr -d "[:space:]")" ]'
check "хук theme-set" "$fix" test -x "$HOME/.config/omarchy/hooks/theme-set.d/50-omawe"
check "хук post-update" "$fix" test -x "$HOME/.config/omarchy/hooks/post-update.d/50-omawe"

echo "Конфликты"
check "нет плагина io.github.dkgamer02ai.wallpaper-engine (он убивает рендереры)" \
  "omarchy plugin remove io.github.dkgamer02ai.wallpaper-engine" \
  test ! -d "$HOME/.config/omarchy/plugins/io.github.dkgamer02ai.wallpaper-engine"
check "нет чужих процессов linux-wallpaperengine" "закройте их: pkill -f 'linux-wallpaperengine.*--screen-root' и systemctl --user restart omawed" \
  sh -c 'for p in $(pgrep -f "linux-wallpaperengin[e] "); do [ "$(cat "/proc/$(ps -o ppid= -p "$p" | tr -d " ")/comm" 2>/dev/null)" = omawed ] || exit 1; done'
bg=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)
if [[ ${state%% *} == off ]]; then
  ok "живые обои не выбраны, фон Omarchy штатный"
else
  check "фон Omarchy — кадр обоев (${bg##*/})" "omawe refresh" sh -c "case '$bg' in */omawe/twins/*|*/themes/omawe-live/*) exit 0;; *) exit 1;; esac"
fi

echo
if (( bad == 0 )); then echo "Всё в порядке."; else echo "Проблем: $bad"; exit 1; fi
